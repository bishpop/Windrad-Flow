{
  "manifest_version": 3,
  "name": "Windrad Flow",
  "version": "0.19.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Windrad Flow",
    "default_popup": "menu.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": [
      "shared.js",
      "toast.js",
      "background.js",
      "peek-bg.js",
      "start-bg.js"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "boosts.js"
      ],
      "run_at": "document_start",
      "exclude_matches": [
        "*://*.youtube.com/live_chat*",
        "*://*.youtube.com/live_chat_replay*",
        "*://*.youtube.com/embed/*"
      ]
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start",
      "exclude_matches": [
        "*://*.youtube.com/live_chat*",
        "*://*.youtube.com/live_chat_replay*",
        "*://*.youtube.com/embed/*"
      ]
    },
    {
      "matches": [
        "*://*.youtube.com/live_chat*",
        "*://*.youtube.com/live_chat_replay*",
        "*://*.youtube.com/embed/*"
      ],
      "js": [
        "shared.js",
        "youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "player.js",
        "notes.js",
        "volume.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "peek.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "__MSG_cmdMenu__"
    },
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Space"
      },
      "description": "__MSG_cmdPalette__"
    },
    "next-space": {
      "suggested_key": {
        "default": "Ctrl+Alt+Right"
      },
      "description": "__MSG_cmdNextSpace__"
    },
    "prev-space": {
      "suggested_key": {
        "default": "Ctrl+Alt+Left"
      },
      "description": "__MSG_cmdPrevSpace__"
    },
    "toggle-note": {
      "suggested_key": {
        "default": "Ctrl+Alt+N"
      },
      "description": "__MSG_cmdNote__"
    },
    "peek-search": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "__MSG_cmdPeekSearch__"
    },
    "copy-url": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmdCopyUrl__"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "tabHide",
    "bookmarks",
    "history",
    "sessions",
    "alarms",
    "contextualIdentities",
    "cookies",
    "scripting",
    "clipboardWrite",
    "menus",
    "declarativeNetRequestWithHostAccess",
    "webRequest",
    "webRequestBlocking",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "palette.html",
        "palette.css",
        "palette.js",
        "shared.js",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "windrad-flow@bishpop",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}